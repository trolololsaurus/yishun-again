# ============================================================
# Yishun Again — environment variable reference
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ------------------------------------------------------------
# Supabase
# PUBLISHABLE_KEY: safe for frontend (respects RLS)
# SECRET_KEY: bypasses RLS — server / agents only, never expose to browser
# ------------------------------------------------------------
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# In Next.js, expose PUBLISHABLE_KEY to the browser via:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ------------------------------------------------------------
# Anthropic (Stage 2 writer — claude-haiku-4-5-20251001 / claude-sonnet-4-6)
# Server / agents only. Never in frontend code.
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------
# Gemini (Stage 1 filter — gemini-3.1-flash-lite)
# Server / agents only. Get a key: https://aistudio.google.com/apikey
#
# Replaced Groq in 2026-07 (Developer tier suspended indefinitely; the 6k TPM
# free tier dropped ~33% of a backfill pass to 429s).
#
# STAGE1_MODEL — override to swap models without a code change.
# STAGE1_RPM / STAGE1_RPD — free-tier limits (30 RPM / 1500 RPD). These are
#   ADVISORY defaults: the real cap varies by region, account age and billing,
#   and Google publishes it only in AI Studio, not the docs. A real 429 is the
#   ground truth. Check yours: https://aistudio.google.com/rate-limit
#   RPD quota resets at midnight US/Pacific (NOT SGT).
#
# These must ALSO be set on Cloud Run (agents backend) — see infra/cloudbuild.yaml.
# Not needed in Vercel: the frontends never call Stage 1.
# ------------------------------------------------------------
GEMINI_API_KEY=
STAGE1_MODEL=gemini-3.1-flash-lite
STAGE1_RPM=30
STAGE1_RPD=1500

# ------------------------------------------------------------
# Cloudflare R2 (image storage)
# Bucket name: yishun-assets
# Public custom domain: assets.yishunagain.com
#
# To get these values:
#   1. Cloudflare dashboard → R2 → Manage R2 API tokens
#   2. Create token with Object Read & Write on bucket yishun-assets
#   3. CF_R2_ACCOUNT_ID is your Cloudflare account ID (top-right of dashboard)
# ------------------------------------------------------------
CF_R2_ACCOUNT_ID=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_BUCKET_NAME=yishun-assets

# ------------------------------------------------------------
# ------------------------------------------------------------
# Next.js ISR (Incremental Static Regeneration)
# REVALIDATE_SECRET: Used by /api/revalidate endpoint for on-demand cache invalidation
# Generate a strong random secret (e.g., `openssl rand -base64 32`)
# Must be added to Vercel environment variables before production deploy
# ------------------------------------------------------------
REVALIDATE_SECRET=
# Cloudflare Stream (Phase 2 only — leave blank for Phase 1)
# ------------------------------------------------------------
CF_STREAM_TOKEN=

# ------------------------------------------------------------
# MapLibre — OpenFreeMap Liberty style
# No API key, no domain registration, no rate limits.
# https://openfreemap.org
# ------------------------------------------------------------
NEXT_PUBLIC_MAPLIBRE_STYLE=https://tiles.openfreemap.org/styles/liberty

# ------------------------------------------------------------
# Modal.run (SDXL pixel art generation)
# Get from: modal.com → Settings → API tokens
# ------------------------------------------------------------
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ------------------------------------------------------------
# Reddit — no credentials needed.
# Scraper uses the public RSS API (search.rss endpoint).
# No client ID or secret required.
# ------------------------------------------------------------

# ------------------------------------------------------------
# Agents backend ops token (security fix B2)
# All /ops endpoints (pipeline/run, pattern/run, etc.) require this in the
# X-Ops-Token header. Absence → 503; wrong value → 401.
# Generate: openssl rand -base64 32
# Set in Cloud Run: gcloud run services update yishun-agents --set-secrets OPS_TOKEN=ops-token:latest
# ------------------------------------------------------------
OPS_TOKEN=

# ------------------------------------------------------------
# GCP (agents backend — Google Cloud Run)
# Used by gcloud CLI during deploy, not at runtime.
# ------------------------------------------------------------
GCP_PROJECT_ID=yishun-again
GCP_REGION=asia-southeast1

# ------------------------------------------------------------
# Autonomy — daily unattended pass (docs/AUTONOMY.md)
# ------------------------------------------------------------
# Where every operator alert goes: review queue, anomalies, maintenance
# digests, health alarms, monthly reports.
OPERATOR_EMAIL=

# Email transport. Absent => alerts are still RECORDED in the notifications
# table and visible in War Room, but nothing is sent. notify() never fails.
# Get a key: https://resend.com/api-keys
RESEND_API_KEY=
# Sender. resend.dev works with zero DNS setup; switch to a verified
# yishunagain.com sender once the domain is set up in Resend.
NOTIFY_FROM=Yishun Again <onboarding@resend.dev>
# Kill switch for sending, without removing the key.
NOTIFY_ENABLED=true

# Auto-publish gate (req #3). A draft at or above this confidence is published
# with no human review. The four hardcoded legal guardrails still apply and are
# NOT overridable by this value — see docs/AUTONOMY.md.
AUTO_PUBLISH_CONFIDENCE=0.95
# Blast-radius cap per run. Excess stays pending for the operator.
AUTO_PUBLISH_MAX_PER_RUN=25

# Learning-delta tracking (req #5)
LEARNING_WINDOW_DAYS=30
LEARNING_MIN_SAMPLES=20

# Cost guard (req #12) — the daily estimate that trips a 'health' alert.
COST_ALERT_USD_PER_DAY=2.00

# Per-agent kill switch, comma-separated. Turns an agent off without a
# redeploy. Names: auto_publish, integrity, supervisor, learning_monitor,
# backend_health, maintenance, monthly_report
AGENT_DISABLED=

# Ingestion pass budget in seconds. Must leave room inside the Cloud Run
# request timeout (3600s) for the seven agents that run after it.
INGESTION_MAX_SECONDS=1500

# In-process APScheduler. FALSE in production: Cloud Run scales to zero, so a
# background scheduler needs min-instances=1 + CPU-always-allocated (~$15-25/mo
# for ~15 min of daily work). Production is driven by Cloud Scheduler hitting
# POST /orchestrator/daily. Set true only for local scheduling.
ENABLE_INPROCESS_SCHEDULER=false

# ------------------------------------------------------------
# Story clustering (gather -> cluster -> write-once). docs/INGESTION_DESIGN.md.
# Fixes the single-source-per-incident problem: today N outlets reporting one
# event produce N Sonnet drafts and one single-source incident. Clustering groups
# them so one draft is written with all sources (corroboration_count = N).
#   off    — per-candidate path, byte-identical (default)
#   shadow — current path unchanged, but LOGS what clustering would group
#            (validate on live data before it writes anything)
#   on     — write one row per cluster  [not wired yet; treated as shadow]
# ------------------------------------------------------------
CLUSTER_BEFORE_WRITE=off
# Grouping thresholds (biased toward SPLIT — a wrong merge corrupts an incident,
# a wrong split is a cosmetic miss). Stricter than consolidation's overlap=1.
CLUSTER_MIN_OVERLAP=2
CLUSTER_DATE_WINDOW_DAYS=3
CLUSTER_MAX_SIZE=6

# ------------------------------------------------------------
# App URLs
# NEXT_PUBLIC_SITE_URL: public-facing domain — canonical host is WWW.
#   Must match in Vercel env vars (canonical/OG/sitemap URLs are built from it).
# WAR_ROOM_URL: private subdomain, protected by Cloudflare Access
#               never expose in public DNS or sitemap
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.yishunagain.com
WAR_ROOM_URL=https://warroom.yishunagain.com

# ------------------------------------------------------------
# GitHub (reference — not used at runtime)
# ------------------------------------------------------------
GITHUB_REPO_URL=https://github.com/trolololsaurus/yishun-again

