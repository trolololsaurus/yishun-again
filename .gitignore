# Environment variables — NEVER commit these
.env
.env.*
.env.local
.env.production
.env.*.local
*.env
**/.env
**/secrets.json

# Python
__pycache__/
*.py[cod]
venv/
.venv/

# Node
node_modules/
.next/
dist/
build/

# OS
.DS_Store
Thumbs.db

# Model weights — never commit
*.safetensors

# Backfill run artifacts — local debugging only
packages/agents/*.log
packages/agents/scrapers/*.log
packages/agents/backfill_*.txt
