# ============================================================
# War Room — environment variables
# Copy to .env.local and fill in real values.
# Never commit .env.local — it is in .gitignore.
# ============================================================

# ------------------------------------------------------------
# Supabase
# SECRET_KEY bypasses RLS — server-side only, never expose to browser.
# War Room has no public routes so all Supabase access uses the secret key.
# ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------
# Cloudflare Access
# OPERATOR_EMAIL: restrict the War Room to a single operator.
#   Must be lowercase — Cloudflare normalises emails before injecting
#   the cf-access-authenticated-user-email header.
# CF_ACCESS_CLIENT_ID / CF_ACCESS_CLIENT_SECRET: service token for
#   server-to-server calls from the agents backend (Cloud Run → War Room).
# ------------------------------------------------------------
OPERATOR_EMAIL=your@email.com
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# ------------------------------------------------------------
# Site URLs
# WAR_ROOM_URL: used for internal redirects and link generation.
# NEXT_PUBLIC_SITE_URL: link back to the public-facing site.
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
WAR_ROOM_URL=
