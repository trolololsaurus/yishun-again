# ============================================================
# War Room — environment variables
# Copy to .env.local and fill in real values.
# Never commit .env.local — it is in .gitignore.
# ============================================================

# ------------------------------------------------------------
# Supabase
# SECRET_KEY bypasses RLS — server-side only, never expose to browser.
# War Room has no public routes so all Supabase access uses the secret key.
# ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------
# Cloudflare Access
# CF_ACCESS_TEAM_DOMAIN / CF_ACCESS_AUD: REQUIRED in production. The
#   middleware verifies the Cf-Access-Jwt-Assertion JWT signature against
#   https://<team-domain>/cdn-cgi/access/certs and checks the application
#   AUD tag. Unset in production => every request is rejected (fail closed).
#   Team domain looks like "myteam.cloudflareaccess.com"; the AUD tag is on
#   the Access application's overview page.
# OPERATOR_EMAIL: restrict the War Room to a single operator (checked
#   against the verified JWT's email claim; lowercase).
# CF_ACCESS_CLIENT_ID / CF_ACCESS_CLIENT_SECRET: service token for
#   server-to-server calls from the agents backend (Cloud Run → War Room).
#   Service-token JWTs carry common_name instead of email and pass the
#   middleware without the OPERATOR_EMAIL check.
# ------------------------------------------------------------
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
OPERATOR_EMAIL=your@email.com
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# ------------------------------------------------------------
# Site URLs
# WAR_ROOM_URL: used for internal redirects and link generation.
# NEXT_PUBLIC_SITE_URL: link back to the public-facing site.
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
WAR_ROOM_URL=
